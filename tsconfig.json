{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "include": [
        "extension/**/*",
        "types/**/*"
    ]
}
